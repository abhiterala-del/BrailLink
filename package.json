{
  "name": "brailink",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test:production": "node scripts/smoke-test.mjs",
    "test": "node --import tsx --test shared/*.test.ts server/*.test.ts",
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "print-server": "tsx print-server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^2.28.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-query": "^5.60.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.453.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.103.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@replit/vite-plugin-shadcn-theme-json": "^0.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.3",
    "typescript": "5.6.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Convert handwriting, speech and typed text to braille and print it on a Raspberry Pi embosser"
}
