# Web app (npm run dev / npm start)
# PORT=5001

# Handwriting recognition (OCR): choose a provider and set its key.
#   OCR_PROVIDER=gemini     -> needs GEMINI_API_KEY
#   OCR_PROVIDER=anthropic  -> needs ANTHROPIC_API_KEY
#   OCR_PROVIDER=openai     -> needs OPENAI_API_KEY (or OPENAI_BASE_URL)
# Left blank, the first provider with a key is used (OpenAI, then Anthropic, then Gemini).
OCR_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OCR_MODEL=                   # defaults: gpt-4.1-mini, claude-haiku-5-5, gemini-2.5-flash

# Any OpenAI-compatible service works for "openai", e.g.
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1  (no key needed; set OCR_MODEL to a vision model)
# OPENAI_BASE_URL=

# Voice transcription: any OpenAI-compatible speech-to-text API.
# Uses OPENAI_API_KEY / OPENAI_BASE_URL unless overridden here, e.g. Groq:
#   TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
#   TRANSCRIBE_API_KEY=<groq key>
#   TRANSCRIBE_MODEL=whisper-large-v3-turbo
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-1

# Where the browser sends print jobs (baked in at build time)
# VITE_PRINT_SERVER_URL=http://localhost:3000

# Print server (npm run print-server), runs on the same network as the Raspberry Pi
# PRINT_PORT=3000
# PI_HOST=raspberrypi.local
# PI_USER=pi
# PI_SSH_KEY=~/.ssh/id_rsa
# ALLOWED_ORIGIN=http://localhost:5001
